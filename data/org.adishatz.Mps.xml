<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">

<node>
  <!--
      org.adishatz.Mps:
      @short_description: Mps daemon
  -->
  <interface name='org.adishatz.Mps'>
     <!--
        Set:

        Set setting to value
      -->
      <method name='Set'>
        <arg direction='in' name='setting' type='s'/>
        <arg direction='in' name='value' type='v'/>
      </method>

    <!--
        StopDozing:

        Ask Mps to stop dozing for a short period (less than 30 seconds)
      -->
      <method name='StopDozing'>
      </method>

      <!--
        ScreenStateChanged:

        Signal emitted when screen state changed.
      -->
      <signal name='ScreenStateChanged'>
        <arg type='b' name='enabled'/>
      </signal>

    <!--
        StopDozing:

        Signal emitted when StopDozing method has been called.
      -->
      <signal name='StopDozing'>
      </signal>

   </interface>
</node>
