[org.adishatz.Mps]
suspend-services=true
suspend-user-services-blacklist=['dbus.service', 'calls-daemon.service','sm.puri.Phosh.service', 'mobi.phosh.Shell.service', 'gnome-session-manager@phosh.service', 'pulseaudio.service', 'mobile-power-saver.service', 'org.gnome.SettingsDaemon.Power.service', 'org.gnome.SettingsDaemon.ScreensaverProxy.service', 'dconf.service', 'audiosystem-passthrough.service', 'headphone-manager.service', 'xdg-document-portal.service', 'xdg-desktop-portal.service', 'org.gnome.SettingsDaemon.MediaKeys.service']
suspend-system-services-blacklist=['dbus.service', 'systemd-resolved.service', 'systemd-timesyncd.service', 'systemd-udevd.service', 'systemd-journald.service', 'systemd-logind.service', 'ofono.service', 'NetworkManager.service', 'ModemManager.service', 'NetworkManager-dispatcher.service', 'wpa_supplicant.service', 'phosh.service', 'ssh.service', 'sensorfwd.service', 'iio-sensor-proxy.service', 'battery-input-manager.service']
suspend-system-bluetooth-services=['bluebinder.service', 'bluetooth.service']
suspend-user-bluetooth-services=['mpris-proxy.service', 'obex.service']
cpuset-topapp=['mobi.phosh.Shell.service']
cpuset-background-processes=['qcrild', 'ofonod', 'ofono2mm', 'batterysecret', 'sscrpcd', 'ipacm-diag', 'sensors.qti', 'vendor.qti.hardware.sensorscalibrate@1.0-service', 'android.hardware.sensors@1.0-service', 'rmt_storage', 'tftp_server']
